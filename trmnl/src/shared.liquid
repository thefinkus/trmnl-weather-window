      const low = Math.min(...H.temperature_2m.slice(i0, i0 + (24 - hr) + 8));
      if (low <= 0){ fact = `${mean(H.cloud_cover, i0, 8) < 50 ? 'Clear' : 'Dry'} tonight, down to ${deg(low)}.`; if (maxToday > 3) turn = 'frostTonight'; }
      else { fact = `Tomorrow: ${tomorrow.toLowerCase()}, ${deg(D.temperature_2m_max[1])}.`; if (tomorrow.includes('SUN')) turn = 'tomorrowFine'; }
    }
    else if (key === 'heat' || (maxToday >= 30 && maxHour > hr)){ fact = maxHour > hr ? `${deg(maxToday)} by ${clock(String(maxHour).padStart(2, '0') + ':00')}.` : 'Hot until dark.'; turn = 'heat'; }
    else if (key === 'frost'){
      let e = -1; for (let i = i0 + 1; i <= last; i++) if (H.temperature_2m[i] > 0.5){ e = i; break; }
      fact = e > 0 && H.is_day[e] ? `Frost until ${at(e)}, then ${after(e) || 'cloud'}.` : 'Below zero all day.';
    }
    else if (key === 'dawn'){ const cl = mean(H.cloud_cover, i0, Math.max(3, Math.round(toSet / 60))); fact = `Sun up at ${clock(D.sunrise[0].slice(11))}. ${cl < 25 ? 'Clear all day.' : cl < 80 ? 'Sun and cloud today.' : 'Cloud later.'}`; }
    else if (key === 'sunset'){ fact = `Sun down at ${clock(D.sunset[0].slice(11))}.` + (frostAhead ? ' Frost by morning.' : ''); if (frostAhead) turn = 'frostTonight'; }
    else if (night) fact = cloud > 70 ? 'Cloud overnight.' : `Clear night, down to ${deg(lowNight)}.`;
    else {
      
      const sky = v => v > 80 ? 'grey' : v > 25 ? 'mixed' : 'sun', s0 = sky(cloud), iDark = i0 + Math.max(0, Math.floor(toSet / 60));
      let ch = -1; for (let i = i0 + 2; i < iDark; i++){ const s1 = sky(mean(H.cloud_cover, i, 3)); if ((s0 === 'grey' && s1 === 'sun') || (s0 !== 'grey' && s1 === 'grey')){ ch = i; break; } }
      const tail = moment === 'morning' ? 'all day' : 'until dark';
      if (ch > 0){ fact = s0 === 'grey' ? `Grey until ${at(ch)}, then sun.` : `Sun until ${at(ch)}, then cloud.`; turn = s0 === 'grey' ? 'sunLater' : 'cloudLater'; }
      else if (frostAhead && moment === 'afternoon'){ fact = `${key === 'clear' ? 'Clear' : 'Dry'} until dark. Frost by morning.`; turn = 'frostTonight'; }
      else fact = key === 'haze' ? `Hazy and dry ${tail}.` : s0 === 'grey' ? `Grey ${tail}.` : s0 === 'mixed' ? `Sun and cloud ${tail}.` : `Clear ${tail}.`;
    }
  }

  
  const wd = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'][now.getDay()];
  const left = moment === 'evening' ? `TONIGHT   ${deg(Math.min(...H.temperature_2m.slice(i0, i0 + (24 - hr) + 8)))}` : `${wd}   ${deg(D.temperature_2m_max[0])} / ${deg(D.temperature_2m_min[0])}`;
  const right = `TOMORROW   ${tomorrow}   ${deg(D.temperature_2m_max[1])}`;

  if (!turn && night && key === 'overcast') turn = 'cloudNight';   
  
  const set = turn === 'heat' ? REMARKS.heat : (turn && EXTRA[turn]) || REMARKS[key];
  const calm = !turn && ['clear', 'partly', 'overcast', 'haze'].includes(key), wk = calm ? EXTRA[wd.toLowerCase()] : null;
  const seed = Math.floor((now - new Date(now.getFullYear(), 0, 1)) / 36e5);   
  
  const pic = Math.floor((seed - 5) / 24);
  return { key, moment, hr, fact, turn, left, right, set, wk, seed, pic };
}

const remark = (st, n) => {
  const fits = s => { const m = /\|(\d+)-(\d+)$/.exec(s); return !m || (st.hr >= +m[1] && st.hr < +m[2]); };
  const pool = list => { const f = list.filter(fits); return f.length ? f : list; };
  const i = st.seed + n, list = st.wk && i % 6 === 0 ? pool(st.wk) : pool(st.set), k = st.wk && i % 6 === 0 ? Math.floor(i / 6) : i;
  return list[k % list.length].replace(/\|\d+-\d+$/, '');
};
function wwRing(px){ var s = [], a, r; for (r = 1; r <= 2; r++) for (a = 0; a < 12; a++) s.push((Math.cos(a * Math.PI / 6) * px * r / 2).toFixed(2) + 'px ' + (Math.sin(a * Math.PI / 6) * px * r / 2).toFixed(2) + 'px 0 #000'); return s.join(','); }
/* the town for "lat,lon" from WW_TOWNS (towns.js): nearest within 60 km, weighted by size (distance over the fourth
   root of the population, at least 1.5 km), so a point in Munich says Munich, one in Santa Monica says Santa Monica */
function wwTown(ll){
  if (!ll || typeof WW_TOWNS === 'undefined') return '';
  var p = String(ll).split(','), la = parseFloat(p[0]), lo = parseFloat(p[1]); if (isNaN(la) || isNaN(lo)) return '';
  var rows = WW_TOWNS.split('\n'), best = '', bs = 1e9, c = Math.cos(la * Math.PI / 180), i, r, dy, dx, d, s;
  for (i = 0; i < rows.length; i++){
    r = rows[i].split('|'); dy = (r[1] - la) * 111.2; if (dy > 60 || dy < -60) continue;
    dx = (((r[2] - lo + 540) % 360) - 180) * 111.2 * c; d = Math.sqrt(dx * dx + dy * dy); if (d > 60) continue;
    s = Math.max(d, 1.5) / Math.pow(+r[3], 0.25); if (s < bs){ bs = s; best = r[0]; }
  }
  return best;
}
function wwPaint(el){
  var mode = el.getAttribute('data-ww'), w = el.clientWidth, h = el.clientHeight, probe = el.querySelector('.ww-probe');
  var isX = window.WW_FORCE ? window.WW_FORCE === 'x' : !!probe && getComputedStyle(probe).display !== 'none';
  var tall = h > w * 1.05, st = null, line2 = '';
  try { WW_OPT.f = WW_SET.units === 'f'; WW_OPT.h12 = WW_SET.clock === '12'; st = story(WW_DATA); line2 = remark(st, 0); } catch (e) { st = null; }
  if (!st) st = { key: 'overcast', fact: 'No forecast right now.', left: '', right: '', seed: 0, pic: 0 }, line2 = 'Look out of the real window.';
  var list = STILLS[st.key], id = list[((st.pic % list.length) + list.length) % list.length];   /* one photograph per mood and day */
  var img = document.createElement('img'); img.className = 'image image-dither'; img.alt = ''; img.style.objectFit = 'cover';
  img.src = WW_BASE + (isX ? 'x' : 'og') + (tall ? '_portrait' : '') + '/' + id + '.png';
  el.appendChild(img);
  /* text sizes, readable from across the room: both lines 44 px and the corner notes 19.7 px on an 800 px wide
     picture (on the X: 104 and 46 device px, about 11.5 and 5 mm), weight 600, a soft shade behind them */
  var small = mode !== 'full', k = Math.min(w, h * 1.7) / 800 * (small ? 1.1 : 1);
  var fs1 = Math.max(isX ? 22 : 24, 44.4 * k), fs3 = Math.max(isX ? 13 : 15, 19.7 * k);
  var both = mode === 'full' || mode === 'half_horizontal';
  var shade = function(edge, part, dark){ var d = document.createElement('div'); d.className = 'ww-shade'; d.style[edge] = '0'; d.style.height = part + '%'; d.style.background = 'linear-gradient(to ' + (edge === 'top' ? 'bottom' : 'top') + ',rgba(0,0,0,' + dark + '),rgba(0,0,0,' + (dark * 0.7).toFixed(2) + ') 45%,rgba(0,0,0,0))'; el.appendChild(d); };
  shade('bottom', both ? 40 : 30, 0.86); shade('top', small ? 20 : 13, 0.7);
  var sub = document.createElement('div'); sub.className = 'ww-sub text--center'; sub.style.bottom = (small ? 5 : 4.2) + '%'; sub.style.textShadow = wwRing(fs1 * (isX ? 0.10 : 0.13));
  var a = document.createElement('span'); a.textContent = st.fact; sub.appendChild(a);
  var lines = [a];
  if (both){ var b = document.createElement('i'); b.textContent = line2; sub.appendChild(b); lines.push(b); }
  el.appendChild(sub);
  /* a long line shrinks until it fits; measured again once the webfont is there */
  var fit = function(){ var room = sub.clientWidth, j, wd; for (j = 0; j < lines.length; j++){ lines[j].style.fontSize = fs1 + 'px'; wd = lines[j].scrollWidth; if (wd > room) lines[j].style.fontSize = Math.max(fs1 * 0.6, fs1 * room / wd * 0.99).toFixed(1) + 'px'; } };
  fit();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
  var note = function(text, side){ if (!text) return; var d = document.createElement('div'); d.className = 'ww-note'; d.style.fontSize = fs3 + 'px'; d.style.top = (2.9 * (w / h > 1 ? 1 : 0.7)) + '%'; d.style[side] = '3.2%'; d.style.textShadow = wwRing(fs3 * 0.16); d.textContent = text; el.appendChild(d); };
  var place = WW_SET.place || wwTown(WW_SET.ll);
  note((place ? place.toUpperCase() + '   ' : '') + st.left, 'left');
  if (mode === 'full' && !tall) note(st.right, 'right');
  if (mode === 'full' && tall && st.right){ var d2 = document.createElement('div'); d2.className = 'ww-note'; d2.style.fontSize = fs3 + 'px'; d2.style.top = '4.6%'; d2.style.left = '3.2%'; d2.style.textShadow = wwRing(fs3 * 0.16); d2.textContent = st.right; el.appendChild(d2); }
}
document.addEventListener('DOMContentLoaded', function(){ var all = document.querySelectorAll('.ww'), i; for (i = 0; i < all.length; i++) if (!all[i].getAttribute('data-done')){ all[i].setAttribute('data-done', '1'); wwPaint(all[i]); } });
{% endraw %}
</script>
